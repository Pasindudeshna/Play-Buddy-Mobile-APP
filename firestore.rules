rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isMatchPlayer(matchId) {
      return isSignedIn()
        && request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.players;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }

    // Facility-web owner profiles, keyed by their Auth uid (shared Auth pool
    // with the mobile app's users/{uid} — see facility-web/src/lib/firebase.ts).
    // Written on signup in facility-web/src/routes/LoginPage.tsx.
    match /ground_owners/{ownerId} {
      allow read: if isOwner(ownerId) || isAdmin();
      allow create, update: if isOwner(ownerId);
      allow delete: if false;
    }

    match /matchQueue/{ticketId} {
      // Clients create their own ticket and can cancel it (from "waiting" or
      // while "choosing" between candidates). Only Cloud Functions (Admin
      // SDK, bypasses rules) may set status:"matched"/"choosing"/"expired"
      // or write matchId — so match outcomes can't be forged client-side.
      // See functions/src/matching.ts.
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'waiting';
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && resource.data.status in ['waiting', 'choosing']
        && request.resource.data.status == 'cancelled';
      allow delete: if false;

      // Candidate list for a "choosing" ticket — populated by
      // functions/src/matching.ts, chosen via the selectMatchCandidate
      // callable. Only the ticket's own owner may see who matched.
      match /candidates/{candidateId} {
        allow read: if isSignedIn()
          && get(/databases/$(database)/documents/matchQueue/$(ticketId)).data.userId == request.auth.uid;
        allow write: if false;
      }
    }

    match /facilities/{facilityId} {
      // Approved listings are visible to any signed-in client (mirrors the
      // users/{userId} read policy). Owners can always see their own
      // pending/rejected drafts; admins can see everything.
      allow read: if (isSignedIn() && resource.data.status == 'approved')
        || isAdmin()
        || (isSignedIn() && resource.data.ownerId == request.auth.uid);

      // Owners self-register; status is always forced to 'pending' on
      // create — approval can only ever be granted by an admin update,
      // never by the creator.
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.sports is list
        && request.resource.data.sports.size() > 0
        && request.resource.data.location is latlng;

      // Admin can update anything (approve/reject/edit). Owner can only
      // edit their own doc while it's pending/rejected, cannot change
      // ownerId, and can only ever move status back to 'pending'
      // (resubmit-after-rejection flow) — never to 'approved'.
      //
      // Exception: pricing/hours (used for ground booking + slot
      // allocation) are not moderation-worthy content, so an owner may
      // update *only* those fields on an already-approved listing without
      // re-triggering admin review.
      allow update: if isAdmin()
        || (
          isSignedIn()
          && resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId
          && resource.data.status in ['pending', 'rejected']
          && request.resource.data.status == 'pending'
        )
        || (
          isSignedIn()
          && resource.data.ownerId == request.auth.uid
          && resource.data.status == 'approved'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
            ['pricePerHour', 'currency', 'openingTime', 'closingTime', 'slotDurationMinutes', 'updatedAt']
          )
        );

      // Owner can withdraw their own listing unless it's currently live
      // (approved) — admin can delete/unpublish anything, any time.
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.ownerId == request.auth.uid
            && resource.data.status != 'approved');
    }

    function isFacilityOwner(facilityId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/facilities/$(facilityId)).data.ownerId == request.auth.uid;
    }

    match /bookings/{bookingId} {
      // Visible to the player who booked it, the ground's owner, an admin,
      // or — for a booking created from a Find Buddy match's venue
      // confirmation (matchId set) — the *other* matched player too, so both
      // sides of the match can see the same booking/confirmation code.
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid
            || resource.data.ownerId == request.auth.uid
            || isAdmin()
            || (resource.data.matchId != null
                && request.auth.uid in get(/databases/$(database)/documents/matches/$(resource.data.matchId)).data.players));

      // Players book their own slot on an approved facility. ownerId is
      // denormalized from the facility doc at write time so rules (and the
      // owner's bookings dashboard) don't need an extra read — but it must
      // match the real facility owner, and status/paymentStatus always
      // start at "confirmed"/"unpaid" (auto-confirm, pay-at-venue model;
      // no payment gateway is wired up, see docs discussion in this repo).
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'confirmed'
        && request.resource.data.paymentStatus == 'unpaid'
        && get(/databases/$(database)/documents/facilities/$(request.resource.data.facilityId)).data.status == 'approved'
        && request.resource.data.ownerId == get(/databases/$(database)/documents/facilities/$(request.resource.data.facilityId)).data.ownerId
        && (request.resource.data.matchId == null
            || request.auth.uid in get(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data.players);

      // The booker may only cancel their own booking. The facility owner may
      // only mark it paid/unpaid (e.g. after a pay-at-venue cash payment).
      // Neither can alter the slot, price, or whose booking it is.
      allow update: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
            && request.resource.data.status == 'cancelled')
        || (isFacilityOwner(resource.data.facilityId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentStatus', 'updatedAt']));

      // Keep booking history intact — nobody deletes bookings client-side.
      allow delete: if false;
    }

    match /matches/{matchId} {
      // Checks resource.data directly (not a get() lookup) so this also
      // works for the match-history list query
      // (where("players","array-contains", uid)) — Firestore can only prove
      // a `list` request is safe when the rule reads straight off the
      // document being evaluated, not an extra get() call.
      allow read: if isSignedIn() && request.auth.uid in resource.data.players;
      // Only Cloud Functions (Admin SDK) create/update match documents.
      allow write: if false;

      match /venueOptions/{venueId} {
        allow read: if isMatchPlayer(matchId);
        // Populated by the onMatchCreated Cloud Function; voting goes
        // through the castVote callable so it can enforce one-vote-per-user
        // and membership checks server-side. See functions/src/venues.ts.
        allow write: if false;
      }

      match /messages/{messageId} {
        allow read: if isMatchPlayer(matchId);
        allow create: if isMatchPlayer(matchId)
          && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}
